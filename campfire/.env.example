# 复制为 .env 后填写。配置名与上游 config.json 的字段一一对应（大写），环境变量优先于配置文件。
# 列表、布尔值要写成 Python 字面量，例如 SINGLE_CHAT_PREFIX='[""]'、AGENT=False

# 大模型（兼容 OpenAI 接口格式的服务均可，密钥只存在本机）
BOT_TYPE=custom
CUSTOM_API_BASE=https://api.deepseek.com/v1
CUSTOM_API_KEY=
MODEL=deepseek-chat

# 客服人设（回答风格、业务范围、不知道时怎么说）
CHARACTER_DESC=你是本店的智能客服，只回答与本店商品、订单、售后相关的问题；不确定时请客户联系人工客服。

# 面向外部客户时建议关闭 Agent 模式：Agent 模式下模型可调用工具执行命令
AGENT=False
# 客户发消息就回复，不要求带前缀
SINGLE_CHAT_PREFIX=[""]

# 接入通道，只写需要的，多个用逗号：wechat_kf（微信客服，对外部微信用户）/ wechatcom_app（企微自建应用，对企业内成员）/ wechatmp（订阅号）/ wechatmp_service（认证服务号）
CHANNEL_TYPE=wechat_kf

# ---- 微信客服 wechat_kf（企业微信后台：微信客服，绑定自建应用）----
WECHAT_KF_CORP_ID=
WECHAT_KF_SECRET=
WECHAT_KF_TOKEN=
WECHAT_KF_AES_KEY=
WECHAT_KF_PORT=9888
WECHAT_KF_CURSOR_PATH=/home/agent/.cow/wechat_kf_cursors.json

# ---- 企微自建应用 wechatcom_app ----
WECHATCOM_CORP_ID=
WECHATCOMAPP_AGENT_ID=
WECHATCOMAPP_SECRET=
WECHATCOMAPP_TOKEN=
WECHATCOMAPP_AES_KEY=
WECHATCOMAPP_PORT=9898

# ---- 微信公众号 wechatmp / wechatmp_service ----
# 容器内不是 root，不能监听 80 端口：容器监听 8080，再由反向代理把 80 转到 8080
WECHATMP_APP_ID=
WECHATMP_APP_SECRET=
WECHATMP_TOKEN=
WECHATMP_AES_KEY=
WECHATMP_PORT=8080
